# 面板登录密码（必填）。install.sh 会自动生成一个随机密码
APP_PASSWORD=

# LLM：任何 OpenAI 兼容接口，默认 DeepSeek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# 默认关闭模型的思考模式（整理归类用不到，开着又慢又容易被截断）；要开就改成 enabled
# LLM_THINKING=disabled

# 可选
# TZ_NAME=Asia/Shanghai              定时任务按哪个时区算
# DATA_DIR=/opt/nodeseek-hub/backend/data
# HTTPS_PROXY=http://127.0.0.1:7890  程序的出站请求走代理（国内本地调试时用；登录用的浏览器不走它）
